SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Gemini LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI LLM Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# RAG & Embedding Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5
RERANK_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.0
MAX_UPLOAD_SIZE=10485760
VECTOR_SERVICE_CLASS=rag_app.services.vector_service.VectorService
EMBEDDING_SERVICE_CLASS=rag_app.services.embedding_service.EmbeddingService

# Database Settings (Uses SQLite by default if POSTGRES_DB is empty)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Rate Limiting (LLM API calls per window)
LLM_RATE_LIMIT_CALLS=60
LLM_RATE_LIMIT_PERIOD=60

# In-memory Cache TTL (seconds)
QUERY_CACHE_TTL=300
EMBEDDING_CACHE_TTL=1800

# Logging
LOG_LEVEL=INFO
